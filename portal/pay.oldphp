<?php
session_start();
require_once "../core/db.php";

// Load PesaFlux functions
require_once "../core/pesaflux.php";

// ===== Get payment from session =====
$token = $_SESSION['payment_token'] ?? null;
if (!$token) exit("Session expired");

$stmt = $pdo->prepare("SELECT * FROM payments WHERE payment_token=?");
$stmt->execute([$token]);
$payment = $stmt->fetch();

if (!$payment) exit("Invalid payment");

// ===== SEND STK ON POST =====
if ($_SERVER['REQUEST_METHOD'] === 'POST') {

    // Format phone properly
    $phone = preg_replace('/\D/', '', $_POST['phone']); // remove spaces, +, dashes
    if (substr($phone, 0, 1) === "0") {
        $phone = "254" . substr($phone, 1);
    } elseif (substr($phone, 0, 3) !== "254") {
        exit("Invalid phone number format");
    }

    $amount = (int)$payment['amount']; // ensure integer

    // Send STK push
    $response = stkPush($amount, $phone, "H-Payment");

    // Log response for debugging
    file_put_contents(__DIR__ . "/stk_log.txt", date('Y-m-d H:i:s') . " -> " . json_encode($response) . PHP_EOL, FILE_APPEND);

    if (!empty($response['transaction_request_id'])) {
        // Save transaction info
        $pdo->prepare("
            UPDATE payments
            SET transaction_request_id = ?, phone = ?
            WHERE payment_id = ?
        ")->execute([
            $response['transaction_request_id'],
            $phone,
            $payment['payment_id']
        ]);

        // Redirect to waiting page
        header("Location: pay.php?waiting=1");
        exit;
    }

    // If we reach here, something went wrong
    echo "<h3>Failed to send STK push</h3>";
    echo "<pre>";
    print_r($response);
    echo "</pre>";
    exit;
}

?>

<?php if (isset($_GET['waiting'])): ?>

<h2>📲 STK Sent</h2>
<p>Enter your M-Pesa PIN on your phone.</p>
<p>Connecting you automatically once payment is confirmed...</p>

<script>
setInterval(() => {
    fetch("payment_status.php")
        .then(res => res.text())
        .then(status => {
            if (status === "ACTIVE") {
                window.location = "create.php";
            }
        });
}, 3000);
</script>

<?php else: ?>

<form method="post">
    <h2>Pay KES <?= $payment['amount'] ?></h2>

    <input name="phone"
           placeholder="07XXXXXXXX"
           required
           style="padding:10px;width:250px">

    <button type="submit">Pay Now</button>
</form>

<?php endif; ?>
