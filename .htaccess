RewriteEngine On

# Prevent directory listing
Options -Indexes

# Allow existing files and directories through as-is
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Remove .php extension — but ONLY for URLs that don't already end in .php
RewriteCond %{REQUEST_URI} !\.php$
RewriteRule ^(.+)$ $1.php [L,QSA]

<Files "deploy.php">
    Require all denied
</Files>

<Files "core/config/config.php">
    Require all denied
</Files>

<Files "subscription_payment_config.php">
    Order allow,deny
    Deny from all
</Files>